<?xml version="1.0" encoding="utf-8"?>
<!--
قواعد النسخ الاحتياطي للإصدارات الأقدم من Android 12 —
 استبعاد كامل للبيانات الحساسة (قاعدة البيانات، DataStore، النسخ الاحتياطية،
 ملفات PDF والصور الشخصية) — خزّنتها لا تصلح للنسخ السحابي غير المشفّر.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
