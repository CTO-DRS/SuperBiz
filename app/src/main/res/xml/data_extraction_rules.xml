<?xml version="1.0" encoding="utf-8"?>
<!--
قواعد استخراج البيانات (Android 12+) — تطبيق مالي
 قاعدة بيانات الأعمال كاملة، DataStore، النسخ الاحتياطية، الملفات الشخصية
 لا تُنقل أبداً عبر النسخ السحابي أو نقل الجهاز. النسخ الاحتياطي المشفّر
 داخل التطبيق (BackupRepo) هو الوسيلة الوحيدة لنقل البيانات.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
