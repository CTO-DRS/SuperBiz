<?xml version="1.0" encoding="utf-8"?>
<!--
    ويدجت المخزون المنخفض — RemoteViews (مشاهدات مسموحة فقط: LinearLayout/FrameLayout/TextView/ImageView/ImageButton)
    النقر على الجسم يفتح التطبيق على تبويب المخزون، وزر التحديث يجدد الأرقام فوراً
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_stock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- الصف الأول: أيقونة + عنوان + زر تحديث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_icon_bg_amber">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_stock"
                android:contentDescription="@string/widget_stock_label" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:text="@string/widget_stock_label"
            android:textColor="#FFFFE3B8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/widget_stock_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_refresh_bg"
            android:src="@drawable/widget_ic_refresh"
            android:scaleType="centerInside"
            android:contentDescription="@string/widget_updated" />
    </LinearLayout>

    <!-- العدد الكبير: أصناف تحت حد الطلب (بلون حسب الخطورة) -->
    <TextView
        android:id="@+id/widget_stock_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_stock_label"
        android:textColor="#FFFFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- شريحتان: النافدة + المنخفضة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_stock_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFC7D4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_stock_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFE3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- أسماء أكثر الأصناف إلحاحاً (أو تلميح حد الطلب) -->
    <TextView
        android:id="@+id/widget_stock_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#FF94A3B8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- آخر تحديث -->
    <TextView
        android:id="@+id/widget_stock_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF94A3B8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
