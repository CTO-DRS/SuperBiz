<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الويدجت: زجاج داكن بتدرج بنفسجي←سماوي مطابق لهوية التطبيق -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF1E1B4B"
        android:centerColor="#FF171536"
        android:endColor="#FF0B1020"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#267C3AED" />
</shape>
