DATABASE_URL="file:./db/custom.db"

# ─── W1.5 (Issue #39) — مصادقة المالك ───────────────────────────────────────
# كلمة مرور المالك (حد أدنى 4 أحرف — يُستحسن PIN طويل أو عبارة):
SUPERBIZ_OWNER_PASSWORD=""
# أو بصمة PBKDF2 جاهزة (الأأمن — بلا كلمة مرور نصية في البيئة). توليدها:
#   node -e "const c=require('crypto').webcrypto;(()=>{})()" — أو ببساطة اترك
#   SUPERBIZ_OWNER_PASSWORD وستُشتق البصمة مرة واحدة في الذاكرة ولا تُخزَّن.
# SUPERBIZ_OWNER_PASSWORD_HASH="pbkdf2$sha256$210000$<saltB64>$<hashB64>"
# سر توقيع الجلسة (اختياري — يُشتق حتمياً من بصمة الاعتماد إن تُرك فارغاً):
SUPERBIZ_SESSION_SECRET=""
